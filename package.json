{
  "name": "@resauce-dev/directus-image-scout",
  "description": "Image Scout is a Directus interface that allowing you to search online image libraries for images.",
  "author": "Shea Lavington <resauce@lavington.me>",
  "license": "GNU GENERAL PUBLIC LICENSE",
  "version": "3.2.0",
  "icon": "image_search",
  "main": "index.js",
  "keywords": [
    "directus",
    "directus-extension",
    "directus-extension-bundle",
    "extension",
    "image",
    "library",
    "vue",
    "javascript",
    "unsplash",
    "pexels",
    "pixabay",
    "giphy",
    "royalty free",
    "resauce"
  ],
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "directus-extension build",
    "dev": "directus-extension build -w --no-minify",
    "link": "directus-extension link",
    "validate": "directus-extension validate",
    "add": "directus-extension add"
  },
  "devDependencies": {
    "@directus/extensions-sdk": "16.0.2",
    "typescript": "^5.9.3",
    "vue": "^3.5.22",
    "@types/node": "^24.6.1"
  },
  "directus:extension": {
    "partial": false,
    "type": "bundle",
    "path": {
      "app": "dist/app.js",
      "api": "dist/api.js"
    },
    "entries": [
      {
        "type": "endpoint",
        "name": "resauce-image-scout",
        "source": "src/endpoints/index.ts"
      },
      {
        "type": "interface",
        "name": "resauce-image-scout-ui",
        "source": "src/interface/index.ts"
      }
    ],
    "host": "^10.10.0"
  }
}
